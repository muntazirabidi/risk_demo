# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration
PORT=3001
NODE_ENV=development

# API Model Configuration
# Using GPT-4o with web search capabilities for real-time financial data
# GPT-4o provides the latest information with authentic sources and citations
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=4000

# CORS Configuration (optional - defaults to allowing all origins in development)
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting (optional)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
